package components

templ Base(title string, head ...templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96"/>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
			<link rel="manifest" href="/site.webmanifest"/>
			<script src="https://unpkg.com/htmx.org@2.0.0"></script>
			for _, v := range head {
				@v
			}
			if title != "" {
				<title>Readers App | { title }</title>
			} else {
				<title>Readers App</title>
			}
		</head>
		<body>
			<div id="global-alert"
				class="fixed top-4 right-4 z-50 w-80 min-h-14">
			</div>
			{ children... }
			<script>
				document.addEventListener('htmx:afterSwap', (e) => {
				if (e.target.id !== 'global-alert') return;
				if (!e.target.children.length) return;
				clearTimeout(window._alertTimer);
				window._alertTimer = setTimeout(() => { e.target.innerHTML = ''; }, 3000);
				});
			</script>
		</body>
	</html>
}

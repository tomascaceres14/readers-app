package components

templ AuthCard(name string, heads templ.Component) {
	@Base(name, heads) {
		<div class="flex justify-center items-center min-h-screen">
			{ children... }
		</div>
	}
}

templ LoginHead() {
	<script type="module" src="/static/js/firebase.js"></script>
	<script type="module" src="/static/js/login.js"></script>
}

templ RegisterHead() {
	<script type="module" src="/static/js/firebase.js"></script>
	<script type="module" src="/static/js/register.js"></script>
}

templ LoginForm() {
	@AuthCard("Login", LoginHead()) {
		<div class="card w-96 bg-base-100 card-md shadow-sm">
			<div class="card-body">
				<h2 class="card-title self-center">Login</h2>
				<form id="login-form" class="flex flex-col gap-3" action="/auth/login" method="POST">
					<div class="form-control">
						<label class="label">
							<span class="label-text">Email</span>
						</label>
						<input type="email" name="email" placeholder="email" class="input input-bordered" required/>
					</div>
					<div class="form-control">
						<label class="label">
							<span class="label-text">Password</span>
						</label>
						<input type="password" name="password" placeholder="password" class="input input-bordered" required/>
					</div>
					<div class="form-control mt-6">
						<button class="btn btn-primary">Log in</button>
					</div>
					<input type="hidden" name="token"/>
				</form>
				<div class="flex w-full flex-col">
					<div class="divider">Or</div>
				</div>
				<form action="/auth/login" id="login-google" method="POST">
					<button class="btn bg-white text-black border-[#e5e5e5]">
						<svg aria-label="Google logo" width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><g><path d="m0 0H512V512H0" fill="#fff"></path><path fill="#34a853" d="M153 292c30 82 118 95 171 60h62v48A192 192 0 0190 341"></path><path fill="#4285f4" d="m386 400a140 175 0 0053-179H260v74h102q-7 37-38 57"></path><path fill="#fbbc02" d="m90 341a208 200 0 010-171l63 49q-12 37 0 73"></path><path fill="#ea4335" d="m153 219c22-69 116-109 179-50l55-54c-78-75-230-72-297 55"></path></g></svg>
						Login with Google
					</button>
					<input type="hidden" name="token"/>
				</form>
				<span>New around here? <a href="/register" class="link link-primary">Register</a></span>
			</div>
		</div>
		<div id="login-error" class="text-error hidden"></div>
	}
}

templ RegisterForm() {
	@AuthCard("Register", RegisterHead()) {
		<div class="card w-96 bg-base-100 card-md shadow-sm">
			<div class="card-body">
				<h2 class="card-title self-center">Register</h2>
				<form id="register-form" class="flex flex-col gap-3" action="/auth/register" method="POST">
					<div class="form-control">
						<label class="label">
							<span class="label-text">Username</span>
						</label>
						<input type="text" name="username" placeholder="username" class="input input-bordered" required/>
					</div>
					<div class="form-control">
						<label class="label">
							<span class="label-text">Email</span>
						</label>
						<input type="email" name="email" placeholder="email" class="input input-bordered" required/>
					</div>
					<div class="form-control">
						<label class="label">
							<span class="label-text">Password</span>
						</label>
						<input type="password" name="password" placeholder="password" class="input input-bordered" required/>
					</div>
					<div class="form-control mt-6">
						<button class="btn btn-primary">Register</button>
					</div>
					<input type="hidden" name="token"/>
				</form>
				<div class="flex w-full flex-col">
					<div class="divider">Or</div>
				</div>
				<form action="/auth/register" id="register-google" method="POST">
					<button class="btn bg-white text-black border-[#e5e5e5]" onclick="window.loginWithGoogle()">
						<svg aria-label="Google logo" width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><g><path d="m0 0H512V512H0" fill="#fff"></path><path fill="#34a853" d="M153 292c30 82 118 95 171 60h62v48A192 192 0 0190 341"></path><path fill="#4285f4" d="m386 400a140 175 0 0053-179H260v74h102q-7 37-38 57"></path><path fill="#fbbc02" d="m90 341a208 200 0 010-171l63 49q-12 37 0 73"></path><path fill="#ea4335" d="m153 219c22-69 116-109 179-50l55-54c-78-75-230-72-297 55"></path></g></svg>
						Register with Google
					</button>
					<input type="hidden" name="token"/>
				</form>
				<span>Already have an account? <a href="/login" class="link link-primary">Login</a></span>
			</div>
		</div>
		<div id="login-error" class="text-error hidden"></div>
	}
}
